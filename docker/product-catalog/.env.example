# Copy this file to .env and fill in real values. .env is git-ignored;
# .env.example is committed as documentation of what's required.

# Port this service listens on.
PRODUCT_CATALOG_PORT=3550

# Postgres connection string.
# host is host.docker.internal when this container talks to Postgres
# running on your own machine (not inside a container).
# user/password/database come from docker/postgresql/init.sql.
DB_CONNECTION_STRING=postgres://<user>:<password>@host.docker.internal:5432/<database>?sslmode=disable
