# Copy this file to .env (same folder as docker-compose.yaml) and fill in real values.
# .env is git-ignored; .env.example is committed to document what is required.

# Port the product-catalog service listens on (inside and outside the container).
PRODUCT_CATALOG_PORT=3550

# Password for the Postgres superuser in the db container (POSTGRES_PASSWORD in the postgres image).
POSTGRES_PASSWORD=<choose-a-password>

# Connection string for the app. The host is the Compose service name "db",
# not host.docker.internal, because Postgres now runs in a container on the same network.
# user/password/database come from docker/postgresql/init.sql.
DB_CONNECTION_STRING=postgres://<user>:<password>@db:5432/<database>?sslmode=disable
